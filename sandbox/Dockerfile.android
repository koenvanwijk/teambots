# Optional Android-emulator variant of the TeamBots sandbox.
# The lean image (sandbox/Dockerfile, teambots-sandbox) stays unchanged.
# This variant only adds the libraries, Java and helper scripts the emulator
# needs; the SDK, emulator binary and system image are downloaded on first
# use into the shared volume `tb-android-sdk` (see teambots-android-setup).
#
# Build from the repo, after the base image exists:
#   docker build -t teambots-sandbox:latest sandbox
#   docker build -t teambots-sandbox-android:latest -f sandbox/Dockerfile.android sandbox
#
# Do not add this image to the default CI matrix: it is optional and the SDK
# download is large.
ARG BASE=teambots-sandbox:latest
FROM ${BASE}
USER root
# Runtime libs for QEMU/emulator + JDK for sdkmanager. curl/unzip/wget for the
# first-boot SDK download. procps/file are handy when debugging inside the box.
RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-17-jre-headless curl wget unzip ca-certificates \
        libpulse0 libnss3 libx11-6 libgl1 libxcb1 libxcomposite1 \
        libxcursor1 libxdamage1 libxi6 libxtst6 libglib2.0-0 libxrandr2 \
        libasound2 libgcc-s1 libstdc++6 procps file \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/android-sdk \
    && chown bot:bot /opt/android-sdk
COPY android-setup.sh /usr/local/bin/teambots-android-setup
COPY android-emulator.sh /usr/local/bin/teambots-android-emulator
RUN chmod 755 /usr/local/bin/teambots-android-setup /usr/local/bin/teambots-android-emulator \
    && command -v java >/dev/null \
    && command -v unzip >/dev/null
ENV ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_HOME=/opt/android-sdk
USER bot
WORKDIR /workspace
