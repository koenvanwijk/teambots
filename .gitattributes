# Normalize line endings: store all text as LF and check it out as LF, so editors
# on different machines stop re-committing the whole file as a CRLF<->LF flip.
* text=auto eol=lf

# Binary assets: never touch their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
