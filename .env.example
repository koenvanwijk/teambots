# Copy to .env and fill in the values. Never commit .env.
#   cp .env.example .env

# Encrypts API keys and secrets at rest. Generate with: openssl rand -hex 32
# When you move the database from another machine, reuse that machine's key
# or the stored secrets cannot be decrypted.
TB_SECRET_KEY=

# Host Tailscale IPv4, from `tailscale ip -4` on the VPS. The UI is published
# on this address and on 127.0.0.1, never on the public NIC.
# Example: TB_TAILSCALE_IP=100.69.211.62
TB_TAILSCALE_IP=

# Europe/Amsterdam on the VPS. Used for routines/cron.
TB_TIMEZONE=Europe/Amsterdam

# docker = one container per project (production). local = subprocess (dev only).
TB_SANDBOX=docker

# 1 lets http_request reach Tailscale (100.x) and other private addresses.
# Required on the VPS so the app can call the Spark and Home Assistant.
# Leave at 0 on a laptop that should not send http_request to your LAN.
TB_HTTP_ALLOW_PRIVATE=1

# Public URL of the UI, used to build OAuth redirect URIs. Set this to the
# address you open in the browser, for example http://<tailscale-ip>:18080
# or a later HTTPS name. Leave empty until that URL is known.
# TB_PUBLIC_URL=

# Optional: bind-mount on the host that is mapped to /data in the app container.
# Default is ./data next to docker-compose.yml.
# TB_HOST_DATA=/opt/teambots/data
